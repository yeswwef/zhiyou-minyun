// 智游闽韵 · 数据模型（空壳版）
// 依据《搭建步骤书 v1》2.3 节：先建「账号 + 文旅资源 + 收藏 + 问答历史」四类核心表。
// 后续模块（行程 / 票务 / 商品 / 社区 / 非遗）的表，等你确认需求后再逐步加。

generator client {
  // Prisma 7 推荐的生成器（旧的 prisma-client-js 已废弃）
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // Prisma 7 起连接串写在 prisma7.config.ts 引用的 .env 里，schema 中不写 url
  provider = "mysql"
}

// ---------- 枚举 ----------

enum Role {
  C // C 端游客
  B // B 端商户 / 非遗传承人
  ADMIN // 平台后台管理员
}

enum VenueType {
  SCENIC
  MUSEUM
  PERFORMANCE
}

enum TicketStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum TicketSlotStatus {
  OPEN
  CLOSED
}

enum TicketBookingStatus {
  CONFIRMED
  VERIFIED
  CANCELLED
  EXPIRED
}

enum ResourceType {
  SCENIC // 景点
  FOOD // 美食
  ICH // 非遗
}

enum CommunityPostType {
  CHECKIN
  REVIEW
}

enum CommunityPostStatus {
  PUBLISHED
  HIDDEN
}

// ---------- 账号 ----------

model User {
  id                 String                  @id @default(cuid())
  username           String                  @unique
  nickname           String?
  passwordHash       String
  role               Role                    @default(C)
  merchantName       String? // B 端店铺名
  createdAt          DateTime                @default(now())
  favorites          Favorite[]
  trips              Trip[]
  resourceViews      ResourceView[]
  chatSessions       ChatSession[]
  communityPosts     CommunityPost[]
  communityLikes     CommunityPostLike[]
  communityFavorites CommunityPostFavorite[]
  communityComments  CommunityComment[]
  following          UserFollow[]            @relation("UserFollowing")
  followers          UserFollow[]            @relation("UserFollowers")
  ticketBookings     TicketBooking[]
  createdTicketItems TicketItem[]            @relation("TicketItemCreator")
}

// ---------- 文旅资源 ----------

model Resource {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  type                 ResourceType
  title                String
  district             String?
  image                String?
  summary              String          @db.Text
  description          String?         @db.Text
  history              String?         @db.Text
  openTime             String?
  traffic              String?
  address              String?
  lat                  Float?
  lng                  Float?
  goodFor              String?
  source               String // 资料来源（需求要求素材必须可溯源）
  license              String?
  recommendationWeight Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  tags                 ResourceTag[]
  favorites            Favorite[]
  resourceViews        ResourceView[]
  communityPosts       CommunityPost[]

  @@index([type])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  resources ResourceTag[]
}

model ResourceTag {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

// ---------- 行程 ----------

model Trip {
  id           String    @id @default(cuid())
  userId       String
  title        String
  durationDays Int?
  startDate    DateTime?
  items        Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- 浏览足迹 ----------

model ResourceView {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  viewedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
}

// ---------- RAG 问答历史 ----------

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  title     String
  lang      String        @default("zh")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String // user / assistant
  content   String      @db.Text
  citations Json? // [{ resourceId, title, score }]
  latencyMs Int?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ---------- 文旅社区 ----------

model CommunityPost {
  id                   String                  @id @default(cuid())
  userId               String
  resourceId           String
  type                 CommunityPostType
  status               CommunityPostStatus     @default(PUBLISHED)
  title                String
  content              String                  @db.Text
  rating               Int?
  visitedAt            DateTime?
  recommendationWeight Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource             Resource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  images               CommunityPostImage[]
  likes                CommunityPostLike[]
  favorites            CommunityPostFavorite[]
  comments             CommunityComment[]

  @@index([status, createdAt])
  @@index([resourceId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model CommunityPostImage {
  id        String        @id @default(cuid())
  postId    String
  imageUrl  String
  sortOrder Int           @default(0)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model CommunityPostLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
}

model CommunityPostFavorite {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

// ---------- 平台票务预约：后台统一管理 ----------

model Venue {
  id        String       @id @default(cuid())
  type      VenueType
  name      String
  address   String
  lat       Float?
  lng       Float?
  contact   String?
  image     String?
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tickets   TicketItem[]

  @@index([type, enabled])
}

model TicketItem {
  id               String       @id @default(cuid())
  venueId          String
  createdByAdminId String
  title            String
  summary          String       @db.Text
  description      String?      @db.Text
  notice           String?      @db.Text
  image            String?
  status           TicketStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  venue            Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdByAdmin   User         @relation("TicketItemCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  slots            TicketSlot[]

  @@index([venueId, status])
  @@index([createdByAdminId])
}

model TicketSlot {
  id               String           @id @default(cuid())
  ticketItemId     String
  startAt          DateTime
  endAt            DateTime
  capacity         Int
  bookedCount      Int              @default(0)
  warningThreshold Int              @default(80)
  status           TicketSlotStatus @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ticketItem       TicketItem       @relation(fields: [ticketItemId], references: [id], onDelete: Cascade)
  bookings         TicketBooking[]

  @@index([ticketItemId, startAt])
  @@index([status, startAt])
}

model TicketBooking {
  id           String              @id @default(cuid())
  bookingNo    String              @unique
  verifyCode   String              @unique
  userId       String
  slotId       String
  quantity     Int                 @default(1)
  contactName  String
  contactPhone String
  status       TicketBookingStatus @default(CONFIRMED)
  verifiedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot         TicketSlot          @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([slotId, status])
}
