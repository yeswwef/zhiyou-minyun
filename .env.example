# ===== 智游闽韵 环境变量模板（提交给队友用）=====

# MySQL
DATABASE_URL="mysql://root:密码@localhost:3306/zhiyou"

# Redis（票务热点缓存、分布式互斥重建、接口限流；不配置时自动回退到单进程内存保护）
REDIS_URL="redis://localhost:6379"

# 模型（DashScope 兼容模式，可换 OpenAI）
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v3"
EMBEDDING_DIM="1024"
LLM_MODEL="qwen-plus"
VL_MODEL="qwen-vl-plus"

# RAG：默认读取项目同级 fuzhou_rag 中的TXT；不会自动调用付费模型
RAG_SOURCE_DIR="../fuzhou_rag"
RAG_DATA_DIR=".data/rag"
# 可选独立密钥/兼容接口；留空时使用上面的 DashScope 设置
RAG_API_KEY=""
RAG_MODEL_BASE_URL=""
# 可选 DashScope gte-rerank-v2 完整端点，按账号所在地域填写；空值使用RRF
# Beijing DashScope endpoint; set empty explicitly to disable reranking.
RAG_RERANK_URL="https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
RAG_RERANK_MODEL="gte-rerank-v2"
# info: stage summaries; debug: redacted question/candidate details; off: disabled.
RAG_LOG_LEVEL="info"
# 百炼原生联网：复用服务端RAG密钥；false可关闭。不会自动入库。
RAG_WEB_ENABLED="true"
RAG_WEB_MODEL="qwen-plus"
RAG_WEB_TIMEOUT_MS="30000"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="resources"
VECTOR_BACKEND="auto"

# 会话签名密钥（生产环境必填；请使用至少 32 字节的随机值）
AUTH_SECRET="请替换为随机生成的长密钥"
