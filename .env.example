# ===== 智游闽韵 环境变量模板（提交给队友用）=====

# MySQL
DATABASE_URL="mysql://root:密码@localhost:3306/zhiyou"

# Redis（票务热点缓存、分布式互斥重建、接口限流；不配置时自动回退到单进程内存保护）
REDIS_URL="redis://localhost:6379"

# 模型（千问AI平台 OpenAI 兼容接口；如改用阿里云百炼，请换回 DashScope 地址与 text-embedding-v3 / qwen-plus）
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://maas.qianwenaiapi.com/compatible-mode/v1"
EMBEDDING_MODEL="qwen3.7-text-embedding"
EMBEDDING_DIM="1024"
LLM_MODEL="qwen3.7-plus"
VL_MODEL="qwen3.7-plus"
# 核验/追问等辅助环节使用的快模型（留空则与 LLM_MODEL 相同）
RAG_FAST_MODEL="qwen3.7-flash"
RAG_AUDIT_MODEL=""
RAG_FOLLOWUP_MODEL="qwen3.7-flash"

# RAG：默认读取项目同级 fuzhou_rag 中的TXT；不会自动调用付费模型
RAG_SOURCE_DIR="../fuzhou_rag"
RAG_DATA_DIR=".data/rag"
# 可选独立密钥/兼容接口；留空时使用上面的设置
RAG_API_KEY=""
RAG_MODEL_BASE_URL=""
# 该平台暂不提供 DashScope 原生重排端点；留空时使用 RRF 排序
RAG_RERANK_URL=""
RAG_RERANK_MODEL="gte-rerank-v2"
# info: stage summaries; debug: redacted question/candidate details; off: disabled.
RAG_LOG_LEVEL="info"
# 联网检索：识景讲解缺少非遗知识点时使用 Responses API + web_search
RAG_WEB_ENABLED="true"
RAG_WEB_MODEL="qwen3.7-plus"
RAG_WEB_TIMEOUT_MS="90000"
# 模型高德api：服务端 Key（POI / 天气 / 静态图 / 路线规划）
AMAP_WEB_KEY=""
# 高德 Web端（JS API）：/help 页面浏览器地图，需要 JS API Key + 安全密钥
NEXT_PUBLIC_AMAP_JS_KEY=""
NEXT_PUBLIC_AMAP_SECURITY_CODE=""
# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="resources"
VECTOR_BACKEND="auto"

# 会话签名密钥（生产环境必填；请使用至少 32 字节的随机值）
AUTH_SECRET="请替换为随机生成的长密钥"
